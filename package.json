{
  "name": "purejsimage-corpus",
  "version": "0.1.0",
  "private": true,
  "description": "A provenance-first image format corpus for codecs and scientific raster readers",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./src/catalog/index.ts",
    "./cli": "./src/cli.ts"
  },
  "scripts": {
    "corpus": "node --import tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run corpus -- validate && npm run corpus -- build-index --check && npm run corpus -- verify --collection smoke --offline"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "commander": "15.0.0",
    "fflate": "0.8.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.3.0",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "typescript": "5.9.2",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11"
  }
}
