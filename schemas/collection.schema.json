{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://purejsimage.dev/corpus/schemas/collection.schema.json",
  "title": "Corpus collection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "title",
    "description",
    "intendedUse",
    "networkPolicy",
    "maximumVendoredBytes",
    "caseIds",
    "selectors",
    "exclusions"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "intendedUse": { "type": "string", "minLength": 1 },
    "networkPolicy": { "enum": ["offline", "optional", "required"] },
    "maximumVendoredBytes": { "type": "integer", "minimum": 0 },
    "caseIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 3 }
    },
    "selectors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "minProperties": 1,
        "properties": {
          "domain": { "enum": ["ordinary", "scientific", "geo", "negative"] },
          "formatFamily": { "type": "string", "minLength": 1 },
          "layoutKind": {
            "enum": ["single-file", "companion-set", "multi-file", "directory-tree", "archive"]
          },
          "classification": { "enum": ["valid", "invalid", "nonconformant", "crash-regression"] },
          "feature": { "type": "string", "minLength": 3 },
          "storage": { "enum": ["vendored", "external", "generated"] }
        }
      }
    },
    "exclusions": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 3 }
    }
  }
}
